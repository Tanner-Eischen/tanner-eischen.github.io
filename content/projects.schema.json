{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "projects"],
  "properties": {
    "schema_version": { "const": 1 },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "category",
          "short_summary",
          "contribution",
          "current_readiness",
          "source_revision",
          "source_access",
          "source_repository",
          "source_url",
          "demo_url",
          "report_url",
          "verification_date",
          "evidence",
          "limits",
          "pages",
          "image"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "short_summary": { "type": "string", "minLength": 1 },
          "contribution": { "type": "string", "minLength": 1 },
          "current_readiness": {
            "enum": ["local_evidence", "source_only", "planned"]
          },
          "source_revision": { "type": ["string", "null"] },
          "source_access": {
            "enum": ["public", "private", "sanitized_showcase"]
          },
          "source_repository": { "type": ["string", "null"] },
          "source_url": { "type": ["string", "null"] },
          "demo_url": { "type": ["string", "null"] },
          "report_url": { "type": ["string", "null"] },
          "verification_date": {
            "type": "string",
            "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
          },
          "evidence": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "limits": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "pages": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "image": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["path", "alt", "width", "height"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "alt": { "type": "string", "minLength": 1 },
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
