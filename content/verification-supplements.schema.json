{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "supplements"],
  "properties": {
    "schema_version": { "const": 1 },
    "supplements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "project_id",
          "scope",
          "summary_path",
          "summary_sha256",
          "archive_path",
          "archive_sha256",
          "payload_files",
          "state"
        ],
        "properties": {
          "project_id": {
            "enum": ["geosteering", "marshab", "roof-segmentation"]
          },
          "scope": { "type": "string", "minLength": 1 },
          "summary_path": { "type": "string", "minLength": 1 },
          "summary_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "archive_path": { "type": "string", "minLength": 1 },
          "archive_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "payload_files": { "type": "integer", "minimum": 1 },
          "state": { "const": "locally_verified_unpublished" }
        }
      }
    }
  }
}
