# Authored source uses the same LF convention as the formatter on every OS.
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitattributes text eol=lf

# These files are identified by raw SHA-256, including original line endings.
assets/evidence/** -text diff whitespace=cr-at-eol
assets/downloads/** -text whitespace=cr-at-eol
assets/downloads/*.pdf binary
assets/downloads/*.zip binary
# Upstream Markdown snapshots retain their intentional hard breaks verbatim.
content/source-snapshots/** -text diff whitespace=-blank-at-eol,-blank-at-eof

# Auxiliary public files must have identical bytes on Windows and Linux.
.nojekyll text eol=lf
# Preserve icon bytes verbatim, including the existing SVG-formatted icon.
favicon.ico -text

# New project previews are bound to byte-level evidence and asset reviews.
assets/images/case-harborforge-calibration.svg -text diff
assets/images/case-parametric-modeller-frame.svg -text diff
assets/images/case-ghostfolio-verification-2026-11-05.svg -text diff
